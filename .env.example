# Copy to .env.local and fill in values. Never commit real secrets.

# MongoDB connection string (replica set recommended for transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/hms

# 32+ character random secret used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# One-time setup secret required to create the first SUPER_ADMIN
# Generate with: openssl rand -hex 32
SETUP_SECRET=change-me-setup-secret-generate-a-strong-value

# App URL (used for cookies / absolute URLs)
APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development
